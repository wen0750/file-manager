# Server Configuration
PORT=3000
NODE_ENV=production

# Database (MySQL)
DB_HOST=192.168.1.220
DB_PORT=3306
DB_USER=web_fs
DB_PASSWORD=YraC382XUl6vjh4Z
DB_NAME=file_manager

# Default Admin (created on first run)
AUTO_CREATE_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
