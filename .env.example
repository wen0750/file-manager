# Server Configuration
PORT=3000
NODE_ENV=production

# Database (MySQL)
DB_HOST=192.168.1.220
DB_PORT=3306
DB_USER=web_fs
DB_PASSWORD=YraC382XUl6vjh4Z
DB_NAME=file_manager

# Default Admin (created on first run)
AUTO_CREATE_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@local.test
RESET_ADMIN_PASSWORD=false

# File Storage
ALLOW_FILESYSTEM_SCAN_FOR_MISSING_DB_FILES=false
PRESERVE_UPLOAD_FILENAME=false
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=2147483648

# Storage accounting for files written outside the application
# (logs, files copied straight into the storage directory, auto-generated files).
# The watcher keeps usage near-real-time; the reconcile job periodically corrects
# any drift (default interval: 24h = 86400000 ms).
ENABLE_FILE_WATCHER=true
WATCHER_DEBOUNCE_MS=1500
RECONCILE_INTERVAL_MS=86400000
RECONCILE_STARTUP_DELAY_MS=5000

# Default quota per user in bytes (default: 10GB)
DEFAULT_QUOTA=10737418240

# Session Secret (change this in production!)
SESSION_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# CSRF
CSRF_COOKIE_KEY=csrf-token
